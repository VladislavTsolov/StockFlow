
@model StockFlow.Models.ViewModels.CreateDeliveryViewModel

@{
    ViewData["Title"] = "Record Delivery";
}

<div class="mb-4">
    <p class="text-uppercase fw-semibold mb-1"
       style="color: #b99aff; letter-spacing: 3px;">
        New stock incoming
    </p>
    <h1 class="display-5 fw-bold text-light">Record Delivery</h1>
    <p style="color: #c7bfd5;">
        Log what arrived, who sent it, and how much goes onto your shelves.
    </p>
</div>

<form asp-controller="Deliveries" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card rounded-4 shadow-sm p-4 mb-4"
         style="background-color: #191720; border: 1px solid #30263f; max-width: 800px;">

        <h5 class="text-light mb-3">Delivery Information</h5>

        <div class="mb-3">
            <label asp-for="DeliveryDate" class="form-label">Delivery Date</label>
            <input asp-for="DeliveryDate" type="date" class="form-control" />
            <span asp-validation-for="DeliveryDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SupplierName" class="form-label">Supplier Name</label>
            <input asp-for="SupplierName" class="form-control"
                   placeholder="e.g. TechSupply Ltd." />
            <span asp-validation-for="SupplierName" class="text-danger"></span>
        </div>

        <div class="mb-0">
            <label asp-for="Notes" class="form-label">Notes <span style="color: #a99dbb;">(Optional)</span></label>
            <textarea asp-for="Notes" class="form-control" rows="3"
                      placeholder="Any useful details about this delivery..."></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
    </div>

    <div class="card rounded-4 shadow-sm overflow-hidden mb-4"
         style="background-color: #191720; border: 1px solid #30263f; max-width: 800px;">

        <div class="card-header py-3"
             style="background-color: #211735; border-bottom: 1px solid #49316b;">
            <h5 class="text-light mb-1">Products Received</h5>
            <p class="mb-0" style="color: #c7bfd5;">
                Enter the quantity delivered for each product. Leave quantities at 0 for products not included.
            </p>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="p-4">
                <h6 class="text-light">No products in your inventory yet.</h6>
                <p style="color: #c7bfd5;">
                    Add products before recording a delivery.
                </p>
                <a asp-controller="Products" asp-action="Create"
                   class="btn"
                   style="background-color: #8754e8; color: white;">
                    + Add Product
                </a>
            </div>
        }
        else
        {
            <div class="p-4">
                @for (int i = 0; i < Model.Products.Count; i++)
                {
                    <input asp-for="Products[i].ProductId" type="hidden" />

                    <div class="row align-items-center g-3 py-3"
                         style="border-bottom: 1px solid #30263f;">
                        <div class="col-md-8">
                            <label asp-for="Products[i].Quantity"
                                   class="form-label fw-semibold mb-1">
                                @Model.Products[i].ProductName
                            </label>
                            <div style="color: #a99dbb; font-size: 0.9rem;">
                                Quantity received
                            </div>
                            <span asp-validation-for="Products[i].Quantity"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <input asp-for="Products[i].Quantity"
                                   type="number"
                                   min="0"
                                   class="form-control"
                                   aria-label="Quantity received for @Model.Products[i].ProductName" />
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="mb-5">
        <button type="submit" class="btn btn-lg"
                style="background-color: #8754e8; color: white;">
            Record Delivery
        </button>

        <a asp-controller="Deliveries" asp-action="Index"
           class="btn btn-lg btn-outline-secondary ms-2">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
