@model StockFlow.Models.ViewModels.CreateDeliveryViewModel
<h1>Record Delivery</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="DeliveryDate" class="form-label"></label>
        <input asp-for="DeliveryDate" type="date" class="form-control" />
        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SupplierName" class="form-label"></label>
        <input asp-for="SupplierName" class="form-control" />
        <span asp-validation-for="SupplierName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
    <h3>Products</h3>
    @for (int i = 0; i < Model.Products.Count; i++)
    {
        <input asp-for="Products[i].ProductId" type="hidden" />

        <div class="mb-3">
            <label class="form-label">@Model.Products[i].ProductName</label>

            <input asp-for="Products[i].Quantity"
                   type="number"
                   min="0"
                   class="form-control" />

            <span asp-validation-for="Products[i].Quantity"
                  class="text-danger"></span>
        </div>
    }

    <button type="submit" class="btn btn-primary">
        Record Delivery
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}