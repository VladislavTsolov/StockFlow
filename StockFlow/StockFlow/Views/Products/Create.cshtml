@model StockFlow.Models.Product
@{
    ViewData["Title"] = "Add Product";
}
<div class="mb-4">
    <p class="text-uppercase fw-semibold mb-1"
       style="color: #b99aff; letter-spacing: 3px;">
        Make room on the shelves
    </p>
    <h1 class="display-5 fw-bold text-light">Add Product</h1>
    <p style="color: #c7bfd5;">
        Every well-managed warehouse starts with knowing what you've got.
    </p>
</div>
<div class="card rounded-4 shadow-sm p-4"
     style="background-color: #191720; border: 1px solid #30263f; max-width: 700px;">

    <form asp-controller="Products" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Product Name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Wireless Keyboard" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">Category</label>
            <input asp-for="Category" class="form-control" placeholder="e.g. Electronics" />
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Unit Price</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="QuantityInStock" class="form-label">Initial Stock Quantity</label>
            <input asp-for="QuantityInStock" class="form-control" type="number" min="0" />
            <span asp-validation-for="QuantityInStock" class="text-danger"></span>
        </div>

        <button type="submit" class="btn"
                style="background-color: #8754e8; color: white;">
            Add Product
        </button>

        <a asp-controller="Products" asp-action="Index"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}