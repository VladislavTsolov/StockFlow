
@model IEnumerable<StockFlow.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <p class="text-uppercase fw-semibold mb-1"
           style="color: #b99aff; letter-spacing: 3px;">
            Your warehouse, at a glance
        </p>
        <h1 class="display-5 fw-bold text-light mb-2">Product Inventory</h1>
        <p style="color: #c7bfd5;">
            Everything on your shelves, all in one place. No guesswork required.
        </p>
    </div>

    <a asp-controller="Products" asp-action="Create" class="btn btn-lg"
       style="background-color: #8754e8; color: white; border: 1px solid #a779ff;">
        + Add Product
    </a>
</div>

<div class="card rounded-4 shadow-sm overflow-hidden"
     style="background-color: #191720; border: 1px solid #30263f;">

    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-3"
         style="background-color: #211735; border-bottom: 1px solid #49316b;">
        <h5 class="mb-0 text-light">Stock Overview</h5>
        <span style="color: #c7bfd5;">
            @Model.Count() @(Model.Count() == 1 ? "product" : "products")
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="card-body text-center py-5">
            <h4 class="text-light">Your shelves are looking a little empty.</h4>
            <p style="color: #c7bfd5;">
                Let's fix that. Add your first product to get StockFlow moving.
            </p>
            <a asp-controller="Products" asp-action="Create" class="btn mt-2"
               style="background-color: #8754e8; color: white;">
                + Add Your First Product
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3">Product</th>
                        <th class="py-3">Category</th>
                        <th class="py-3">Unit Price</th>
                        <th class="py-3">Quantity in Stock</th>
                        <th class="py-3 text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@product.Name</td>
                            <td>
                                <span class="badge rounded-pill"
                                      style="background-color: #302342; color: #d9c6ff; border: 1px solid #49316b;">
                                    @product.Category
                                </span>
                            </td>
                            <td>@product.Price.ToString("F2")</td>
                            <td>
                                <span class="fw-semibold" style="color: #c4a8ff;">
                                    @product.QuantityInStock
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-controller="Products" asp-action="Edit"
                                       asp-route-id="@product.Id" class="btn btn-sm"
                                       style="background-color: #7544cf; color: white;">
                                        Edit
                                    </a>
                                    <a asp-controller="Products" asp-action="Delete"
                                       asp-route-id="@product.Id" class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
