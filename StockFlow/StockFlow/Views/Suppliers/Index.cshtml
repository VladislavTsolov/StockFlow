@model IEnumerable<StockFlow.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Suppliers</h2>
            <p class="text-muted">Manage your product suppliers.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Add Supplier</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No suppliers have been registered yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Company</th>
                        <th>Contact Person</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Deliveries</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model)
                    {
                        <tr>
                            <td>@supplier.CompanyName</td>
                            <td>@supplier.ContactPerson</td>
                            <td>@supplier.Email</td>
                            <td>@supplier.PhoneNumber</td>
                            <td>@supplier.Deliveries.Count</td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@supplier.Id"
                                   class="btn btn-sm btn-warning">Edit</a>

                                <a asp-action="Delete"
                                   asp-route-id="@supplier.Id"
                                   class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
